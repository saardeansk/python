def bubblesort (arr):
    for i in range(len(arr)):
        for j in range(0,len(arr)-i-1):
            if (arr[j] > arr[j+1]):
               temp = arr[j]
               arr[j] = arr[j+1]
               arr[j+1] = temp
    return arr

arr = list(map (int,input ("enter the value of array \n").split()))
print(bubblesort(arr))
    
